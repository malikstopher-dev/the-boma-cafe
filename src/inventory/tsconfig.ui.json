{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "../app/dashboard/**/*.tsx",
    "../app/inv/**/*.tsx",
    "ambient.d.ts",
    "../components/admin/design-system/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}